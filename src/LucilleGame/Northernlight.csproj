<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <AssemblyName>DELTARUNE</AssemblyName>
    <RootNamespace>Northernlight</RootNamespace>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Delaunator" Version="1.0.11" />
    <PackageReference Include="Facepunch.Steamworks.Native" Version="1.65.1" />
    <PackageReference Include="ini-parser" Version="2.5.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SDL3-CS" Version="3.4.12.3" />
    <PackageReference Include="SDL3-CS.Native" Version="3.5.0-preview.20260205-174353" />
    <PackageReference Include="SDL3-CS.Native.Image" Version="3.5.0" />
    <PackageReference Include="SDL3-CS.Native.Shadercross" Version="3.0.0" />
    <PackageReference Include="SDL3-CS.Native.TTF" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="chapter6_windows\Assets\gamecontrollerdb.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Rebuild relevant assets before build -->
  <Target Name="LocalizationBuild" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet run --project &quot;$(SolutionDir)src\LocalizationKeyGenerator\LocalizationKeyGenerator.csproj&quot; -- &quot;$(MSBuildProjectDirectory)\Localization\en-US&quot; &quot;$(MSBuildProjectDirectory)\Core\Localization\LocalizationEntries.cs&quot; &quot;Northernlight.Core.Localization&quot; $(OutDir)\chapter6_windows" />
  </Target>

  <Target Name="PreBuild" BeforeTargets="Build;BeforePublish">
    <Exec Command="dotnet run --project &quot;$(SolutionDir)src\AtlasGenerator\AtlasGenerator.csproj&quot; -- &quot;$(MSBuildProjectDirectory)\Assets&quot; &quot;$(MSBuildProjectDirectory)\Core\Rendering\Atlases.cs&quot; &quot;Northernlight.Core.Rendering&quot;" />

    <Exec Command="dotnet run --project &quot;$(SolutionDir)src\NorthernlightStatsRefsBuilder\NorthernlightStatsRefsBuilder.csproj&quot; -- &quot;$(MSBuildProjectDirectory)\Content\Knight\StatsRepository.cs&quot; &quot;Northernlight.Content.Knight&quot; &quot;$(MSBuildProjectDirectory)\Assets\StatsRepository.json&quot;" />

    <Exec Command="dotnet run --project &quot;$(SolutionDir)src\ShaderGenerator\ShaderGenerator.csproj&quot; -- &quot;$(MSBuildProjectDirectory)\Assets&quot; &quot;$(MSBuildProjectDirectory)\Core\Rendering\Shaders.cs&quot; &quot;Northernlight.Core.Rendering&quot;" />
  </Target>

  <!-- Delete redundant leftover file after publishing -->
  <Target Name="DeleteSteamLibFile" AfterTargets="Publish">
    <Delete Files="$(PublishDir)\steam_api64.lib"/>
  </Target>

</Project>
